{
  "name": "mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "React Capacitor 移动应用 - pnpm monorepo",
  "packageManager": "pnpm@8.6.1",
  "scripts": {
    "dev": "pnpm --filter @mobile/app dev",
    "build": "pnpm --filter @mobile/shared build && pnpm --filter @mobile/app build",
    "preview": "pnpm --filter @mobile/app preview",
    "typecheck": "pnpm --filter @mobile/shared typecheck && pnpm --filter @mobile/app typecheck",
    "clean": "rimraf packages/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo",
    "clean:all": "rimraf packages/*/dist packages/*/node_modules node_modules packages/app/*.js packages/app/*.d.ts packages/app/*.tsbuildinfo",
    "deploy:ios": "[ -f .env.local ] && source .env.local; pnpm build && pnpm --filter @mobile/app deploy:ios",
    "deploy:ios:release": "[ -f .env.local ] && source .env.local; pnpm build && pnpm --filter @mobile/app deploy:ios:release",
    "archive:ios": "[ -f .env.local ] && source .env.local; pnpm build && pnpm --filter @mobile/app archive:ios",
    "upload:ios": "[ -f .env.local ] && source .env.local; pnpm --filter @mobile/app upload:ios"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
